# Pooled (e.g. Supabase :6543) for the app. Migrations and baseline use DATABASE_URL_DIRECT.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# Direct PostgreSQL (e.g. Supabase db.<ref>.supabase.co:5432) — required for `prisma migrate` and `db:baseline:*`.
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST:5432/postgres"
#
# On Supabase hosted, `db:migrate:reset` usually FAILS if Prisma manages `auth` (tables are owned by Supabase): use `migrate resolve` baseline instead.
# Local Postgres only — reset wipes `auth` + `core` per Prisma models:
#   npm run db:migrate:reset
#
# If you must keep the live Supabase instance but align history: baseline instead:
#   npm run db:baseline:generate && npm run db:baseline:resolve

# Supabase project URL (no trailing slash). Required to verify ES256 user JWTs via JWKS.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Legacy only: symmetric JWT secret for HS256 tokens. Omit when using SUPABASE_URL + ES256.
# SUPABASE_JWT_SECRET=""
